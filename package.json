{
  "name": "cowove",
  "version": "0.1.0",
  "description": "Real-time, tool-agnostic pair vibe coding: sync a project folder live between collaborators using any AI coding tool.",
  "type": "module",
  "bin": {
    "cowove": "bin/cowove.js"
  },
  "scripts": {
    "build": "node scripts/build-web.js",
    "pretest": "node scripts/build-web.js",
    "test": "node --test test/*.test.js",
    "serve": "node bin/cowove.js serve",
    "prepack": "node scripts/build-web.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "icons": "electron desktop/make-icons.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "chokidar": "^5.0.0",
    "fast-diff": "^1.3.0",
    "ignore": "^7.0.10",
    "lib0": "^0.2.118",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "web"
  ],
  "main": "desktop/main.js",
  "build": {
    "appId": "dev.cowove.app",
    "productName": "cowove",
    "copyright": "MIT License",
    "directories": {
      "buildResources": "desktop/build",
      "output": "dist"
    },
    "files": [
      "bin/**",
      "src/**",
      "assets/**",
      "desktop/main.js",
      "desktop/preload.cjs",
      "desktop/icons/*.png",
      "package.json"
    ],
    "asar": false,
    "protocols": [
      {
        "name": "cowove invite",
        "schemes": [
          "cowove"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "cowove-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "cowove",
      "artifactName": "cowove-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "cowove-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
